# Sunucu panelinin anahtarı. /sunucu sayfasına girerken sorulur.
# Vercel'de Environment Variables altına ekleyin, uzun ve tahmin edilemez olsun.
SUNUCU_ANAHTARI=degistir-beni

# Upstash Redis (Vercel Marketplace > Upstash > Redis ile ekleyince bu ikisi
# otomatik gelir). Yoksa uygulama bellek moduna düşer: yerelde çalışır ama
# Vercel'de katılımcılar senkron olmaz. Yayına almadan önce mutlaka ekleyin.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
