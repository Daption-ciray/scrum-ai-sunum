# Bu dosyayı .env.local olarak kopyalayın ve doldurun.
# .env.local git tarafından yok sayılır — anahtarlar depoya girmez.
#   cp .env.example .env.local

# ---------------------------------------------------------------- sunum
# Sunucu panelinin anahtarı. /sunucu sayfasına girerken sorulur.
# Vercel'de Environment Variables altına da ekleyin. Uzun ve tahmin edilemez olsun.
SUNUCU_ANAHTARI=degistir-beni

# Upstash Redis (Vercel proje sayfası > Storage > Marketplace > Upstash Redis
# ile eklerseniz bu ikisi otomatik gelir). Boş bırakırsanız uygulama bellek
# moduna düşer: yerelde çalışır ama Vercel'de katılımcılar senkron olmaz.
# Yayına almadan önce mutlaka doldurun.
# Vercel Marketplace üzerinden kurulduysa bu ikisi otomatik gelir:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash'i doğrudan kendi panelinden kurduysanız bunlar geçerli:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------- kart görselleri
# Yalnızca kartlar/fal-uret.mjs kullanır. Siteye dahil değil, Vercel'e gerekmez.
# Anahtar: https://fal.ai/dashboard/keys
FAL_KEY=

# Atölye değerlendirmesi — Google AI Studio (Gemini) anahtarı.
# Tanımlı değilse özellik sessizce kapalı kalır: panel yalnızca anahtar
# kelime sıralaması gösterir, atölye yine çalışır.
GOOGLE_AI_API_KEY=""
# İsteğe bağlı — varsayılan gemini-3.5-flash-lite.
# LITE bilinçli: düşünen modeller (3.6-flash) 10 istemi 1,5-3,5 dakikada
# değerlendiriyor ve zaman aşımına takılıyor; lite 1,5 saniyede, aynı sırayla.
HAKEM_MODEL=""

# Yerel geliştirmede depoyu production Redis'inden ayırır.
# "bellek" yazılırsa Upstash bağlantısı yok sayılıp bellek moduna düşülür.
# Vercel'in Development ortamında tanımlı; Production ve Preview'da BOŞ olmalı.
DEPO="bellek"
